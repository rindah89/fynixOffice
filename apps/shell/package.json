{
  "name": "@fynixoffice/shell",
  "productName": "fynixOffice",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rindah89/fynixOffice",
  "private": true,
  "description": "Unified fynixOffice shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "fynixoffice.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@fynixoffice/agent-core": "*",
    "@fynixoffice/ai-provider": "*",
    "@fynixoffice/ai-search": "*",
    "@fynixoffice/docs": "*",
    "@fynixoffice/docx-engine": "*",
    "@fynixoffice/electron-utils": "*",
    "@fynixoffice/i18n": "*",
    "@fynixoffice/governance": "*",
    "@fynixoffice/pptx-engine": "*",
    "@fynixoffice/pptx-render": "*",
    "@fynixoffice/sheets": "*",
    "@fynixoffice/slides": "*",
    "@fynixoffice/suite-auth": "*",
    "@fynixoffice/ui": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "author": "fynixOffice"
}
